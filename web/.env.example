# Required for question generation and grading (server-side only).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional override (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Neon Postgres connection string (required for auth / signup).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_string

# App URL (local or production). Auth.js uses this for callbacks.
AUTH_URL=http://localhost:3000
